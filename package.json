{
  "name": "turbobulls-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Turbobulls Connector: prices from your own market-data provider, with your own API key, for the Turbobulls app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome && wxt build -b edge",
    "build:dev": "wxt build -b chrome --mode development",
    "zip": "wxt zip -b chrome && wxt zip -b edge",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm check:source && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev-id": "node scripts/extension-id.mjs",
    "check:source": "node scripts/check-source.mjs src public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turbobullsapp/turbobulls-extension.git"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0"
  }
}
